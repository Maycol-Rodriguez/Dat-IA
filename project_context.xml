"""Convierte el CSV curado original al JSONL canónico de Dat-IA."""

from __future__ import annotations

import argparse
import csv
import json
import re
from pathlib import Path
from typing import Any

DATASET_VERSION = "1.1.0"
_DECLARED_ROWS_PATTERN = re.compile(
    r"\.\s*Se obtienen\s+(\d+)\s+filas?\s+en\s+total\.\s*$",
    flags=re.IGNORECASE,
)
_FIELD_PATTERN = re.compile(r"(?:^|[;,])\s*([A-Za-z_][A-Za-z0-9_]*):\s*")
_INTEGER_PATTERN = re.compile(r"^-?\d+$")
_FLOAT_PATTERN = re.compile(r"^-?(?:\d+\.\d*|\d*\.\d+)$")

_RESULT_TYPES = {
    "escalar": "scalar",
    "ranking": "ranking",
    "tabla": "table",
    "serie temporal": "time_series",
}

_QUALITY_NOTES = {
    6: [
        "Revisar la frase 'contar reseñas por id, no por review_id': "
        "la consulta calcula AVG(review_score) y no realiza un conteo."
    ],
    7: [
        "Verificar incident_type='retraso_severo' contra los valores reales "
        "y la documentación vigente del DDL."
    ],
    18: [
        "Verificar las categorías esperadas de soporte contra los valores "
        "reales y la documentación vigente del DDL."
    ],
    19: [
        "Verificar los motivos esperados de devolución contra los valores "
        "reales y la documentación vigente del DDL."
    ],
    25: [
        "La referencia declara cinco filas; verificar el catálogo real de "
        "change_reason y la documentación vigente del DDL."
    ],
    26: [
        "Verificar promo_type='descuento_directo' contra los valores reales "
        "y la documentación vigente del DDL."
    ],
}

_OPTIONAL_COLUMNS = {
    15: {"seller_city", "seller_state"},
    22: {"reviews"},
    25: {"price_changes"},
    29: {"seller_city", "seller_state"},
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Convierte el golden set CSV a JSONL UTF-8 estructurado."
    )
    parser.add_argument("source", type=Path, help="CSV de origen.")
    parser.add_argument("destination", type=Path, help="JSONL de destino.")
    parser.add_argument(
        "--encoding",
        default="cp1252",
        help="Codificación del CSV de origen (predeterminado: cp1252).",
    )
    parser.add_argument(
        "--delimiter",
        default=";",
        help="Separador del CSV de origen (predeterminado: ;).",
    )
    return parser.parse_args()


def convert_csv_to_jsonl(
    source: Path,
    destination: Path,
    *,
    encoding: str = "cp1252",
    delimiter: str = ";",
) -> int:
    with source.open("r", encoding=encoding, newline="") as csv_file:
        rows = list(csv.DictReader(csv_file, delimiter=delimiter))

    if not rows:
        raise ValueError("El CSV no contiene casos.")

    cases = [
        _build_case(row, source_row=index)
        for index, row in enumerate(rows, start=1)
    ]

    destination.parent.mkdir(parents=True, exist_ok=True)

    with destination.open("w", encoding="utf-8", newline="\n") as jsonl_file:
        for case in cases:
            jsonl_file.write(
                json.dumps(
                    case,
                    ensure_ascii=False,
                    separators=(",", ":"),
                )
            )
            jsonl_file.write("\n")

    return len(cases)


def _build_case(row: dict[str, str], *, source_row: int) -> dict[str, Any]:
    question = _required(row, "Pregunta", source_row)
    result_type_source = _required(row, "Tipo de resultado", source_row)
    result_type = _RESULT_TYPES.get(result_type_source.casefold())

    if result_type is None:
        raise ValueError(
            f"Fila {source_row}: tipo de resultado desconocido "
            f"{result_type_source!r}."
        )

    quality_notes = _QUALITY_NOTES.get(source_row, [])

    expected_result = _parse_expected_result(
        _required(row, "Respuesta esperada", source_row)
    )
    optional_columns = sorted(_OPTIONAL_COLUMNS.get(source_row, set()))

    for expected_row in expected_result["rows"]:
        for column in optional_columns:
            expected_row.pop(column, None)

    return {
        "case_id": f"golden_{source_row:03d}",
        "enabled": True,
        "split": "core",
        "inputs": {
            "question": question,
        },
        "reference_outputs": {
            "expected_status": "success",
            "expected_sources": [
                table.strip()
                for table in _required(
                    row,
                    "Tablas usadas",
                    source_row,
                ).split(",")
                if table.strip()
            ],
            "reference_sql": _required(
                row,
                "SQL PostgreSQL de referencia",
                source_row,
            ),
            "expected_result": expected_result,
        },
        "metadata": {
            "dataset_version": DATASET_VERSION,
            "domain": _required(row, "Dominio", source_row),
            "result_type": result_type,
            "business_rule": _required(
                row,
                "Regla de negocio",
                source_row,
            ),
            "quality_status": "review_pending" if quality_notes else "ready",
            "quality_notes": quality_notes,
            "omitted_optional_columns": optional_columns,
            "source_row": source_row,
        },
    }


def _parse_expected_result(raw_value: str) -> dict[str, Any]:
    declared_match = _DECLARED_ROWS_PATTERN.search(raw_value)

    if declared_match:
        row_count = int(declared_match.group(1))
        result_text = raw_value[: declared_match.start()]
    else:
        row_count = None
        result_text = raw_value

    result_text = result_text.strip().rstrip(".")
    parsed_rows = [
        _parse_expected_row(row_text)
        for row_text in result_text.split(" | ")
        if row_text.strip()
    ]

    if not parsed_rows:
        raise ValueError(f"No se pudo interpretar la respuesta: {raw_value!r}")

    effective_row_count = row_count or len(parsed_rows)

    if effective_row_count < len(parsed_rows):
        raise ValueError(
            "La cantidad declarada de filas no puede ser menor que "
            "la vista previa."
        )

    return {
        "comparison_mode": (
            "exact" if effective_row_count == len(parsed_rows) else "prefix"
        ),
        "row_count": effective_row_count,
        "rows": parsed_rows,
        "numeric_tolerance": 0.01,
    }


def _parse_expected_row(row_text: str) -> dict[str, Any]:
    matches = list(_FIELD_PATTERN.finditer(row_text))

    if not matches:
        raise ValueError(f"No se reconocieron campos en: {row_text!r}")

    parsed: dict[str, Any] = {}

    for index, match in enumerate(matches):
        value_end = matches[index + 1].start() if index + 1 < len(matches) else None
        raw_value = row_text[match.end() : value_end].strip(" ,;.")
        parsed[match.group(1)] = _parse_scalar(raw_value)

    return parsed


def _parse_scalar(value: str) -> str | int | float:
    if _INTEGER_PATTERN.fullmatch(value):
        return int(value)

    if _FLOAT_PATTERN.fullmatch(value):
        return float(value)

    return value


def _required(
    row: dict[str, str],
    column: str,
    source_row: int,
) -> str:
    value = str(row.get(column) or "").strip()

    if not value:
        raise ValueError(f"Fila {source_row}: falta la columna {column!r}.")

    return value


def main() -> None:
    args = parse_args()
    count = convert_csv_to_jsonl(
        args.source,
        args.destination,
        encoding=args.encoding,
        delimiter=args.delimiter,
    )
    print(f"Golden set generado: {count} casos en {args.destination}")


if __name__ == "__main__":
    main()
