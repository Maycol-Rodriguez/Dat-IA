        second_client,
        embeddings,
    )

    stored = second_collection._collection.get(
        ids=[record.memory_id],
        include=["metadatas"],
    )

    assert second_collection._collection.count() == 1
    assert stored["ids"] == [record.memory_id]
    assert stored["metadatas"][0]["validated"] is True
