<file path="scripts/validate_golden_set_references.py">
"""Valida los SQL de referencia y publica solo casos correctos en producción."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import uuid
from collections.abc import Mapping
from decimal import Decimal
from pathlib import Path
from typing import Any

from sqlalchemy import text

from app.db.connect_db import create_db_engine
from app.evaluation import compare_result_facts, is_read_only_sql

REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CANDIDATE_PATH = (
    REPOSITORY_ROOT
    / "tests"
    / "evaluation"
    / "candidates"
    / "dat_ia_golden_v2_all.jsonl"
)
DEFAULT_PRODUCTION_PATH = (
    REPOSITORY_ROOT
    / "tests"
    / "evaluation"
    / "datasets"
    / "dat_ia_golden_v2.jsonl"
)
DEFAULT_QUARANTINE_PATH = (
    REPOSITORY_ROOT
    / "tests"
    / "evaluation"
    / "quarantine"
    / "dat_ia_golden_v2_review.jsonl"
)
DEFAULT_REPORT_PATH = (
    REPOSITORY_ROOT
    / "reports"
    / "dat_ia_golden_v2_reference_validation.json"
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Ejecuta los SQL de referencia en modo lectura, clasifica los "
            "casos y deja en producción únicamente los correctos."
        )
    )
    parser.add_argument("--candidate-path", type=Path, default=DEFAULT_CANDIDATE_PATH)
    parser.add_argument("--production-path", type=Path, default=DEFAULT_PRODUCTION_PATH)
    parser.add_argument("--quarantine-path", type=Path, default=DEFAULT_QUARANTINE_PATH)
    parser.add_argument("--report-path", type=Path, default=DEFAULT_REPORT_PATH)
    return parser.parse_args()


def validate_references(
    database_url: str,
    *,
    candidate_path: Path = DEFAULT_CANDIDATE_PATH,
    production_path: Path = DEFAULT_PRODUCTION_PATH,
    quarantine_path: Path = DEFAULT_QUARANTINE_PATH,
    report_path: Path = DEFAULT_REPORT_PATH,
) -> dict[str, Any]:
    candidates = _load_jsonl(candidate_path)
    engine = create_db_engine(database_url)
    correct_cases: list[dict[str, Any]] = []
    review_cases: list[dict[str, Any]] = []
    validations: list[dict[str, Any]] = []

    try:
        with engine.connect() as connection:
            with connection.begin():
                if connection.dialect.name == "postgresql":
                    connection.exec_driver_sql("SET TRANSACTION READ ONLY")

                for case in candidates:
                    validation = _validate_case(connection, case)
                    validations.append(validation)

                    classified_case = json.loads(
                        json.dumps(case, ensure_ascii=False)
                    )
                    classified_case["metadata"]["reference_validation"] = {
                        "classification": validation["classification"],
                        "reason": validation["reason"],
                    }

                    if validation["classification"] == "correct":
                        classified_case["metadata"]["quality_status"] = "verified"
                        correct_cases.append(classified_case)
                    else:
                        classified_case["enabled"] = False
                        classified_case["metadata"]["quality_status"] = (
                            "review_required"
                        )
                        review_cases.append(classified_case)
    finally:
        engine.dispose()

    counts = {
        classification: sum(
            item["classification"] == classification
            for item in validations
        )
        for classification in (
            "correct",
            "golden_set_outdated",
            "reference_sql_error",
        )
    }
    report = {
        "dataset_version": "2.0.0",
        "validation_scope": "30 reference SQL queries",
        "database_dialect": engine.dialect.name,
        "counts": counts,
        "production_case_ids": [case["case_id"] for case in correct_cases],
        "review_case_ids": [case["case_id"] for case in review_cases],
        "cases": validations,
    }

    _write_jsonl(production_path, correct_cases)
    _write_jsonl(quarantine_path, review_cases)
    _write_json(report_path, report)
    return report


def _validate_case(connection: Any, case: Mapping[str, Any]) -> dict[str, Any]:
    case_id = str(case["case_id"])
    reference = case["reference_outputs"]
    sql = str(reference["reference_sql"])
    expected = reference["expected_result"]
    context = {
        "case_id": case_id,
        "question": case["inputs"]["question"],
        "reference_sql": sql,
        "expected_sources": reference["expected_sources"],
    }

    if not is_read_only_sql(sql):
        return {
            **context,
            "classification": "reference_sql_error",
            "reason": "El SQL no cumple la política de solo lectura.",
            "expected_result": expected,
            "actual_result": None,
        }

    try:
        with connection.begin_nested():
            result = connection.execute(text(sql))
            actual_rows = [
                {key: _json_value(value) for key, value in row.items()}
                for row in result.mappings()
            ]
    except Exception as exc:  # El reporte debe conservar el error de PostgreSQL.
        return {
            **context,
            "classification": "reference_sql_error",
            "reason": f"{type(exc).__name__}: {exc}",
            "expected_result": expected,
            "actual_result": None,
        }

    actual_result = {
        "row_count": len(actual_rows),
        "rows": actual_rows,
    }

    if compare_result_facts(actual_rows, expected):
        return {
            **context,
            "classification": "correct",
            "reason": "El SQL se ejecutó y el resultado completo coincide.",
            "expected_result": expected,
            "actual_result": actual_result,
        }

    return {
        **context,
        "classification": "golden_set_outdated",
        "reason": _mismatch_reason(actual_rows, expected),
        "expected_result": expected,
        "actual_result": actual_result,
    }


def _mismatch_reason(actual_rows: list[dict[str, Any]], expected: Mapping[str, Any]) -> str:
    expected_rows = expected.get("rows", [])

    if len(actual_rows) != len(expected_rows):
        return (
            "El SQL se ejecutó, pero la cantidad de filas difiere: "
            f"esperadas={len(expected_rows)}, actuales={len(actual_rows)}."
        )

    for index, (actual, expected_row) in enumerate(
        zip(actual_rows, expected_rows, strict=True),
        start=1,
    ):
        if actual != expected_row:
            return (
                f"El SQL se ejecutó, pero la fila {index} difiere. "
                f"Esperada={expected_row}; actual={actual}."
            )

    return "El SQL se ejecutó, pero los valores exceden la tolerancia configurada."


def _json_value(value: Any) -> Any:
    if isinstance(value, Decimal):
        if value == value.to_integral_value():
            return int(value)
        return float(value)

    if isinstance(value, (dt.date, dt.datetime, dt.time)):
        return value.isoformat()

    if isinstance(value, uuid.UUID):
        return value.hex

    if isinstance(value, bytes):
        return value.hex()

    return value


def _load_jsonl(path: Path) -> list[dict[str, Any]]:
    with path.open("r", encoding="utf-8") as jsonl_file:
        return [json.loads(line) for line in jsonl_file if line.strip()]


def _write_jsonl(path: Path, cases: list[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    with path.open("w", encoding="utf-8", newline="\n") as jsonl_file:
        for case in cases:
            jsonl_file.write(
                json.dumps(case, ensure_ascii=False, separators=(",", ":"))
            )
            jsonl_file.write("\n")


def _write_json(path: Path, value: Mapping[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(value, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def main() -> None:
    args = parse_args()
    database_url = os.getenv("DATABASE_URL")

    if not database_url:
        raise SystemExit(
            "DATABASE_URL no está definida. Ejecuta con `uv run --env-file "
            ".env python -m scripts.validate_golden_set_references` o "
            "expórtala en la consola."
        )

    report = validate_references(
        database_url,
        candidate_path=args.candidate_path,
        production_path=args.production_path,
        quarantine_path=args.quarantine_path,
        report_path=args.report_path,
    )
    print(json.dumps(report["counts"], ensure_ascii=False, indent=2))
    print(f"Reporte: {args.report_path}")


if __name__ == "__main__":
    main()
</file>

<file path="tests/evaluation/README.md">
# Golden set end-to-end de Dat-IA

## Fuente canónica

El archivo
[`datasets/dat_ia_golden_v2.jsonl`](datasets/dat_ia_golden_v2.jsonl) es la
fuente de verdad de producción. Está codificado en UTF-8, contiene un objeto
JSON por línea y solo incluye referencias que ya se ejecutaron correctamente
contra la base actual.

JSONL es preferible a CSV para este caso porque cada ejemplo contiene listas de
tablas, varias filas esperadas, metadatos y notas de calidad. En CSV esos campos
terminarían serializados como texto y requerirían un segundo parser. JSONL
mantiene los tipos numéricos, permite leer un caso a la vez y produce cambios
revisables en Git.

El CSV original no es el resultado de una evaluación. Fue una fuente de
curación. La v1 se conserva como historial; la v2 se construye combinándola con
el CSV de respuestas completas:

```powershell
uv run python -m scripts.build_golden_set_v2 RUTA_RESPUESTAS_COMPLETAS.csv
```

El resultado completo de los 30 casos se guarda en
`candidates/dat_ia_golden_v2_all.jsonl`. Luego se validan los SQL de referencia:

```powershell
uv run --env-file .env python -m scripts.validate_golden_set_references
```

Ese comando produce tres artefactos versionados:

- `datasets/dat_ia_golden_v2.jsonl`: casos verificados para producción.
- `quarantine/dat_ia_golden_v2_review.jsonl`: casos desactualizados o con SQL
  inválido, deshabilitados.
- `../../reports/dat_ia_golden_v2_reference_validation.json`: resultados
  completos de la clasificación, incluyendo valores actuales y errores.

## Contrato de cada caso

Cada línea tiene esta estructura:

```json
{
  "case_id": "golden_001",
  "enabled": true,
  "split": "core",
  "inputs": {
    "question": "¿Cuántas órdenes se registraron en total?"
  },
  "reference_outputs": {
    "expected_status": "success",
    "expected_sources": ["olist_orders_dataset"],
    "reference_sql": "SELECT ...",
    "expected_result": {
      "row_count": 1,
      "rows": [{"total_orders": 99441}],
      "numeric_tolerance": 0.01
    }
  },
  "metadata": {
    "dataset_version": "2.0.0",
    "domain": "Órdenes",
    "result_type": "scalar",
    "business_rule": "Contar cada order_id una sola vez.",
    "quality_status": "ready",
    "quality_notes": [],
    "omitted_optional_columns": [],
    "source_row": 1
  }
}
```

`reference_outputs.expected_result` es la única respuesta de referencia del
caso, no la salida de una evaluación. En la v2 siempre contiene todas las filas
y `row_count` debe ser exactamente igual a `len(rows)`. Por eso
`comparison_mode` ya no existe: la comparación completa es la única modalidad.

Los resultados de las evaluaciones end-to-end no se guardan periódicamente en
Git; LangSmith los conserva dentro del experimento. La excepción es el reporte
de validación de referencias, que sí se versiona porque documenta por qué un
caso fue promovido a producción o enviado a cuarentena.

## Auditoría del DDL

El DDL original se conserva en `data/ddl_old.json`. El archivo activo
`data/ddl.json` mantiene la misma estructura verificada contra PostgreSQL y
documenta los valores categóricos observados en la base actual.

Para volver a auditar sin modificar archivos:

```powershell
uv run --env-file .env python -m scripts.refresh_ddl_from_database --audit-only --ddl-path data/ddl_old.json
```

Para refrescar el DDL activo, conservando el respaldo existente:

```powershell
uv run --env-file .env python -m scripts.refresh_ddl_from_database
```

El detalle estructural y semántico queda en
`reports/dat_ia_ddl_validation.json`.

## Versionado

Se utilizan tres niveles complementarios:

1. Git registra cada cambio exacto del archivo.
2. `dataset_version` identifica la versión semántica publicada.
3. LangSmith crea automáticamente una versión temporal cuando un ejemplo se
   agrega o cambia.

Un cambio de redacción que no modifica el significado puede incrementar la
versión de parche. Un cambio de reglas, SQL de referencia o resultados
esperados debe incrementar la versión menor. La eliminación de
`comparison_mode` fue una ruptura de contrato y por eso creó la versión mayor
2 y el dataset `dat_ia_test_golden_v2`.

El sincronizador usa identificadores UUID deterministas derivados de
`dataset_name + case_id`. Por ello, volver a ejecutarlo actualiza el mismo
ejemplo en vez de duplicarlo. No elimina casos remotos automáticamente. La
eliminación requiere revisar la diferencia y ejecutar explícitamente:

```powershell
uv run python -m scripts.sync_langsmith_golden_set --prune
```

## Flujo de evaluación

1. Iniciar Dat-IA y verificar que `/ready` muestre `database=connected`.
2. Validar localmente:

   ```powershell
   uv run python -m scripts.evaluate_langsmith_golden_set --dry-run
   ```

3. Ejecutar el experimento completo:

   ```powershell
   uv run python -m scripts.evaluate_langsmith_golden_set
   ```

El comando sincroniza `dat_ia_test_golden_v2`, llama a `/query/answer` para
cada caso de producción y registra seis métricas en LangSmith:

- `response_status_matches_expected`
- `reported_source_tables_match_expected`
- `generated_sql_is_read_only`
- `result_facts_match_expected`
- `answer_contains_expected_facts`
- `result_schema_and_values_match_expected`

`result_facts_match_expected` es la métrica principal de exactitud: normaliza
números, UUID y periodos mensuales, y compara los valores por fila sin depender
del alias SQL. `answer_contains_expected_facts` comprueba que la redacción
incluya los valores y entidades esperados. La comparación estricta de esquema
se conserva como diagnóstico secundario y no debe interpretarse como la
exactitud principal.

La evaluación completa depende del modelo y de PostgreSQL, por lo que no forma
parte de `pytest`. Las pruebas unitarias validan el contrato del dataset y los
evaluadores deterministas sin hacer llamadas externas.
</file>

