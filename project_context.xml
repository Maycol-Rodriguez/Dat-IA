    "price": "precio",
    "revenue": "ingresos",
    "value": "valor",
    "amount": "monto",
    "quantity": "cantidad",
    "qty": "cantidad",
    "units": "unidades",
    "days": "días",
    "delivery": "entrega",
    "rate": "tasa",
    "score": "puntaje",
    "status": "estado",
    "date": "fecha",
}


def get_column_label(key: str) -> str | None:
    """Devuelve una etiqueta española para una columna o alias."""
    normalized_key = str(key).strip().casefold()

    registered = COLUMN_LABELS_ES.get(
        normalized_key
    )

    if registered is not None:
        return registered

    tokens = [
        token
        for token in re.split(
            r"[_\-\s]+",
            normalized_key,
        )
        if token
    ]

    if not tokens:
        return None

    translated = [
        _TOKEN_LABELS_ES.get(token)
        for token in tokens
    ]

    if any(
        token is None
        for token in translated
    ):
        return None

    label = " ".join(
        token
        for token in translated
        if token is not None
    )

    if not label:
        return None

    return (
        label[0].upper()
        + label[1:]
    )
