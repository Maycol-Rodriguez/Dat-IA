services:
  api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: dat-ia-api
    ports:
      - "8000:8000"
    environment:
      APP_ENV: "${APP_ENV:-test}"
      DATABASE_URL: "${DATABASE_URL:-}"
      GOOGLE_API_KEY: "${GOOGLE_API_KEY:-}"
      USE_CLOUDFLARE_LLM: "${USE_CLOUDFLARE_LLM:-false}"
      CLOUDFLARE_ACCOUNT_ID: "${CLOUDFLARE_ACCOUNT_ID:-}"
      CLOUDFLARE_API_KEY: "${CLOUDFLARE_API_KEY:-}"
      CHROMA_HOST: "${CHROMA_HOST:-}"
      CHROMA_PORT: "${CHROMA_PORT:-8000}"
      USE_LANGSMITH_TRACING: "${USE_LANGSMITH_TRACING:-false}"
      LANGSMITH_API_KEY: "${LANGSMITH_API_KEY:-}"
      LANGSMITH_PROJECT: "${LANGSMITH_PROJECT:-}"
      LANGSMITH_TRACING_SAMPLING_RATE: "${LANGSMITH_TRACING_SAMPLING_RATE:-}"
      LANGSMITH_ENDPOINT: "${LANGSMITH_ENDPOINT:-}"
      LANGSMITH_WORKSPACE_ID: "${LANGSMITH_WORKSPACE_ID:-}"
    volumes:
      # Esto crea una carpeta local llamada .hf_cache y la conecta a la caché del contenedor
      - ./.hf_cache:/app/.cache/huggingface
      - ./chroma_data:/app/chroma_db
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
