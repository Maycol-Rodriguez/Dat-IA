        main_module,
        "build_rag_response",
        fake_build_rag_response,
    )
    monkeypatch.setattr(
        main_module,
        "upsert_query_memory_v2",
        fake_upsert,
    )
    monkeypatch.setattr(
        main_module,
        "mark_query_memory_v2_results_used",
        lambda collection, results: captured.update(
            {
                "used_collection": collection,
                "used_results": results,
            }
        ),
    )
