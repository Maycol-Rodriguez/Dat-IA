        7,
        15,
        12,
        30,
        tzinfo=timezone.utc,
    )

    record = create_query_memory_v2_record(
        original_question="Ventas por mes durante 2018",
        normalized_question="Calcular ventas totales por mes en 2018.",
        intent="temporal_trend",
        metrics=["revenue"],
        filters=[],
        date_range={
            "start_date": "2018-01-01",
            "end_date": "2018-12-31",
        },
        context=["ventas"],
