"""Sincroniza el golden set canónico con un dataset de LangSmith."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from app.evaluation import (
    DEFAULT_GOLDEN_SET_PATH,
    GOLDEN_SET_DATASET_NAME,
    load_golden_set,
    sync_golden_set,
)
from app.observability import get_langsmith_client


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Crea o actualiza el dataset de evaluación en LangSmith."
    )
    parser.add_argument(
        "--dataset-path",
        type=Path,
        default=DEFAULT_GOLDEN_SET_PATH,
    )
    parser.add_argument(
        "--dataset-name",
        default=GOLDEN_SET_DATASET_NAME,
    )
    parser.add_argument(
        "--prune",
        action="store_true",
        help="Elimina de LangSmith ejemplos que ya no existen localmente.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    cases = load_golden_set(args.dataset_path)
    client = get_langsmith_client()

    if client is None:
        raise SystemExit(
            "LangSmith no está configurado. Define USE_LANGSMITH_TRACING=true "
            "y LANGSMITH_API_KEY."
        )

    summary = sync_golden_set(
        client,
        cases=cases,
        dataset_name=args.dataset_name,
        prune=args.prune,
    )
    print(json.dumps(summary, ensure_ascii=False, indent=2))

    if summary["remote_only"]:
        print(
            "Hay ejemplos remotos que no existen localmente. "
            "Revísalos y usa --prune solo si deseas eliminarlos."
        )


if __name__ == "__main__":
    main()
