<file path=".github/workflows/ci.yml">
name: CI

on:
  push:
    branches:
      - main
      - "devops/**"
  pull_request:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  UV_VERSION: "0.11.32"
  PYTHON_VERSION: "3.11"
  MAX_UNPACKED_IMAGE_SIZE_MIB: "1800"
  MAX_COMPRESSED_IMAGE_SIZE_MIB: "650"

jobs:
  quality:
    name: Python quality
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          persist-credentials: false

      - name: Install uv and Python
        uses: astral-sh/setup-uv@08807647e7069bb48b6ef5acd8ec9567f424441b # v8.1.0
        with:
          version: ${{ env.UV_VERSION }}
          python-version: ${{ env.PYTHON_VERSION }}
          enable-cache: true
          cache-dependency-glob: uv.lock

      - name: Verify lockfile
        run: uv lock --check

      - name: Install dependencies
        run: uv sync --frozen

      - name: Run Ruff
        run: uv run ruff check app scripts tests

      - name: Run tests
        run: uv run pytest -q

  container:
    name: Container contract
    runs-on: ubuntu-latest
    needs: quality
    timeout-minutes: 25

    steps:
      - name: Checkout repository
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          persist-credentials: false

      - name: Define image metadata
        shell: bash
        run: |
          set -euo pipefail

          VERSION="$(python3 -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')"

          echo "VERSION=${VERSION}" >> "${GITHUB_ENV}"
          echo "IMAGE=dat-ia-api:ci-${GITHUB_SHA}" >> "${GITHUB_ENV}"

      - name: Build production image
        shell: bash
        run: |
          set -euo pipefail

          docker build \
            --build-arg "VCS_REF=${GITHUB_SHA}" \
            --build-arg "VERSION=${VERSION}" \
            --tag "${IMAGE}" \
            .

      - name: Verify OCI metadata and user
        shell: bash
        run: |
          set -euo pipefail

          image_user="$(docker image inspect --format '{{.Config.User}}' "${IMAGE}")"
          image_revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "${IMAGE}")"
          image_version="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "${IMAGE}")"

          runtime_version="$(
            docker image inspect \
              --format '{{range .Config.Env}}{{println .}}{{end}}' \
              "${IMAGE}" |
              sed -n 's/^APP_VERSION=//p'
          )"

          test "${image_user}" = "10001:10001"
          test "${image_revision}" = "${GITHUB_SHA}"
          test "${image_version}" = "${VERSION}"
          test "${runtime_version}" = "${VERSION}"

          echo "User: ${image_user}"
          echo "Revision: ${image_revision}"
          echo "OCI version: ${image_version}"
          echo "Runtime version: ${runtime_version}"

      - name: Verify Python runtime
        shell: bash
        run: |
          set -euo pipefail

          docker run --rm --interactive --entrypoint python "${IMAGE}" - <<'PY'
          import os

          import chromadb
          import fastapi
          import sqlglot
          import streamlit
          import torch
          import transformers

          from app.main import APP_VERSION, app

          expected_version = os.environ["APP_VERSION"]

          assert APP_VERSION == expected_version, (
              APP_VERSION,
              expected_version,
          )
          assert app.version == expected_version, (
              app.version,
              expected_version,
          )

          assert torch.__version__.endswith("+cpu"), torch.__version__
          assert torch.version.cuda is None, torch.version.cuda
          assert not torch.cuda.is_available()

          print("Production imports: OK")
          print(f"PyTorch: {torch.__version__}")
          print(f"CUDA build: {torch.version.cuda}")
          print(f"APP_VERSION: {APP_VERSION}")
          print(f"FastAPI version: {app.version}")
          print("Version contract: OK")
          PY

      - name: Verify non-root write permissions
        shell: bash
        run: |
          set -euo pipefail

          docker run \
            --rm \
            --entrypoint /bin/sh \
            "${IMAGE}" \
            -c '
              set -eu
              test "$(id -u)" = "10001"
              test "$(id -g)" = "10001"
              touch /app/chroma_db/ci-write-test
              touch /app/.cache/huggingface/ci-write-test
              echo "Non-root write permissions: OK"
            '

      - name: Enforce unpacked image size limit
        shell: bash
        run: |
          set -euo pipefail

          size_bytes="$(docker image inspect --format '{{.Size}}' "${IMAGE}")"
          max_bytes="$((MAX_UNPACKED_IMAGE_SIZE_MIB * 1024 * 1024))"
          size_mib="$((size_bytes / 1024 / 1024))"

          echo "Unpacked image size: ${size_mib} MiB"
          echo "Maximum allowed: ${MAX_UNPACKED_IMAGE_SIZE_MIB} MiB"

          if [ "${size_bytes}" -gt "${max_bytes}" ]; then
            echo "Unpacked image exceeds the permitted size."
            exit 1
          fi

      - name: Enforce compressed image size limit
        shell: bash
        run: |
          set -euo pipefail

          compressed_bytes="$(docker save "${IMAGE}" | gzip -1 | wc -c)"
          compressed_bytes="$(echo "${compressed_bytes}" | tr -d '[:space:]')"

          max_bytes="$((MAX_COMPRESSED_IMAGE_SIZE_MIB * 1024 * 1024))"
          compressed_mib="$((compressed_bytes / 1024 / 1024))"

          echo "Compressed image size: ${compressed_mib} MiB"
          echo "Maximum allowed: ${MAX_COMPRESSED_IMAGE_SIZE_MIB} MiB"

          if [ "${compressed_bytes}" -gt "${max_bytes}" ]; then
            echo "Compressed image exceeds the permitted size."
            exit 1
          fi

      - name: Show image summary
        if: always()
        run: docker image ls "${IMAGE}"
