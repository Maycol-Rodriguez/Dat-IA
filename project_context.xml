<file path=".github/workflows/publish-container.yml">
name: Publish container

on:
  push:
    branches:
      - main
    tags:
      - "v*.*.*"
  workflow_dispatch:

permissions:
  contents: read
  packages: write

concurrency:
  group: publish-container-${{ github.ref }}
  cancel-in-progress: false

env:
  REGISTRY: ghcr.io
  SCAN_IMAGE: dat-ia-api:security-scan
  DOCKER_METADATA_SHORT_SHA_LENGTH: "12"

jobs:
  publish:
    name: Scan and publish
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          persist-credentials: false

      - name: Define release metadata
        shell: bash
        run: |
          set -euo pipefail

          version="$(
            python3 -c \
              'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])'
          )"

          repository="${GITHUB_REPOSITORY,,}"
          image_name="${REGISTRY}/${repository}"

          echo "VERSION=${version}" >> "${GITHUB_ENV}"
          echo "IMAGE_NAME=${image_name}" >> "${GITHUB_ENV}"

          if [ "${GITHUB_REF_TYPE}" = "tag" ]; then
            if [[ ! "${GITHUB_REF_NAME}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
              echo "Unsupported release tag: ${GITHUB_REF_NAME}"
              exit 1
            fi

            tag_version="${GITHUB_REF_NAME#v}"

            if [ "${tag_version}" != "${version}" ]; then
              echo "Git tag version: ${tag_version}"
              echo "Project version: ${version}"
              echo "The release tag and pyproject.toml version must match."
              exit 1
            fi
          fi

          echo "Image: ${image_name}"
          echo "Version: ${version}"
          echo "Revision: ${GITHUB_SHA}"

      - name: Generate image tags and labels
        id: meta
        uses: docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302 # v6.2.0
        with:
          images: ${{ env.IMAGE_NAME }}
          flavor: |
            latest=false
          tags: |
            type=sha,format=long
            type=raw,value=latest,enable={{is_default_branch}}
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=semver,pattern={{major}},enable=${{ !startsWith(github.ref, 'refs/tags/v0.') }}
          labels: |
            org.opencontainers.image.title=Dat-IA API
            org.opencontainers.image.description=API de consultas en lenguaje natural sobre PostgreSQL
            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
            org.opencontainers.image.revision=${{ github.sha }}
            org.opencontainers.image.version=${{ env.VERSION }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@d7f5e7f509e45cec5c76c4d5afdd7de93d0b3df5 # v4.1.0

      - name: Build image for security scan
        uses: docker/build-push-action@f9f3042f7e2789586610d6e8b85c8f03e5195baf # v7.2.0
        with:
          context: .
          load: true
          tags: ${{ env.SCAN_IMAGE }}
          build-args: |
            VCS_REF=${{ github.sha }}
            VERSION=${{ env.VERSION }}
          cache-from: type=gha,scope=dat-ia-api-amd64
          provenance: false
          sbom: false

      - name: Scan critical vulnerabilities
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          scan-type: image
          image-ref: ${{ env.SCAN_IMAGE }}
          format: table
          scanners: vuln
          vuln-type: os,library
          severity: CRITICAL
          ignore-unfixed: true
          exit-code: "1"

      - name: Log in to GHCR
        uses: docker/login-action@4907a6ddec9925e35a0a9e82d7399ccc52663121 # v4.1.0
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and publish image
        id: push
        uses: docker/build-push-action@f9f3042f7e2789586610d6e8b85c8f03e5195baf # v7.2.0
        with:
          context: .
          platforms: linux/amd64
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            VCS_REF=${{ github.sha }}
            VERSION=${{ env.VERSION }}
          cache-from: type=gha,scope=dat-ia-api-amd64
          cache-to: type=gha,mode=max,scope=dat-ia-api-amd64
          provenance: mode=max
          sbom: true

      - name: Verify published digest
        shell: bash
        env:
          IMAGE_DIGEST: ${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail

          case "${IMAGE_DIGEST}" in
            sha256:*)
              ;;
            *)
              echo "Invalid image digest: ${IMAGE_DIGEST}"
              exit 1
              ;;
          esac

          docker buildx imagetools inspect \
            "${IMAGE_NAME}@${IMAGE_DIGEST}"

      - name: Write publication summary
        shell: bash
        env:
          IMAGE_DIGEST: ${{ steps.push.outputs.digest }}
          IMAGE_TAGS: ${{ steps.meta.outputs.tags }}
        run: |
          {
            echo "## Dat-IA container"
            echo
            echo "- Image: \`${IMAGE_NAME}\`"
            echo "- Version: \`${VERSION}\`"
            echo "- Revision: \`${GITHUB_SHA}\`"
            echo "- Digest: \`${IMAGE_DIGEST}\`"
            echo
            echo "### Published tags"
            echo '```text'
            echo "${IMAGE_TAGS}"
            echo '```'
          } >> "${GITHUB_STEP_SUMMARY}"
