"""Construye el candidato v2 con todas las respuestas esperadas del CSV."""

from __future__ import annotations

import argparse
import csv
import json
import re
from collections import defaultdict
from pathlib import Path
from typing import Any

DATASET_VERSION = "2.0.0"
REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_BASE_PATH = (
    REPOSITORY_ROOT
    / "tests"
    / "evaluation"
    / "datasets"
    / "dat_ia_golden_v1.jsonl"
)
DEFAULT_DESTINATION = (
    REPOSITORY_ROOT
    / "tests"
    / "evaluation"
    / "candidates"
    / "dat_ia_golden_v2_all.jsonl"
)
_SOURCE_ID_PATTERN = re.compile(r"^GS-(\d{3})$")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Combina el contrato v1 con el CSV que contiene todas las "
            "filas esperadas y genera el candidato v2 en JSONL UTF-8."
        )
    )
    parser.add_argument("responses_csv", type=Path)
    parser.add_argument("--base-path", type=Path, default=DEFAULT_BASE_PATH)
    parser.add_argument("--destination", type=Path, default=DEFAULT_DESTINATION)
    parser.add_argument("--encoding", default="cp1252")
    parser.add_argument("--delimiter", default=";")
    return parser.parse_args()


def build_golden_set_v2(
    responses_csv: Path,
    *,
    base_path: Path = DEFAULT_BASE_PATH,
    destination: Path = DEFAULT_DESTINATION,
    encoding: str = "cp1252",
    delimiter: str = ";",
) -> list[dict[str, Any]]:
    base_cases = _load_jsonl(base_path)
    expected_by_case = _load_complete_responses(
        responses_csv,
        encoding=encoding,
        delimiter=delimiter,
    )
    base_ids = {case["case_id"] for case in base_cases}

    if set(expected_by_case) != base_ids:
        missing = sorted(base_ids - set(expected_by_case))
        unexpected = sorted(set(expected_by_case) - base_ids)
        raise ValueError(
            "Los IDs del CSV no coinciden con el contrato base. "
            f"Faltantes={missing}; inesperados={unexpected}."
        )

    cases = [
        _build_case(case, expected_rows=expected_by_case[case["case_id"]])
        for case in base_cases
    ]
    _write_jsonl(destination, cases)
    return cases


def _load_complete_responses(
    source: Path,
    *,
    encoding: str,
    delimiter: str,
) -> dict[str, list[dict[str, Any]]]:
    indexed_rows: dict[str, list[tuple[int, dict[str, Any]]]] = defaultdict(list)

    with source.open("r", encoding=encoding, newline="") as csv_file:
        reader = csv.reader(csv_file, delimiter=delimiter)
        header = next(reader, None)

        if header is None or len(header) < 3:
            raise ValueError("El CSV debe contener tres columnas.")

        for source_line, row in enumerate(reader, start=2):
            if not row or not any(cell.strip() for cell in row):
                continue

            if len(row) < 3:
                raise ValueError(
                    f"Línea {source_line}: se esperaban tres columnas."
                )

            source_id = row[0].strip()
            match = _SOURCE_ID_PATTERN.fullmatch(source_id)

            if match is None:
                raise ValueError(
                    f"Línea {source_line}: ID inválido {source_id!r}."
                )

            case_id = f"golden_{match.group(1)}"

            try:
                row_number = int(row[1].strip())
            except ValueError as exc:
                raise ValueError(
                    f"Línea {source_line}: número de fila inválido."
                ) from exc

            try:
                expected_row = json.loads(row[2].strip())
            except json.JSONDecodeError as exc:
                raise ValueError(
                    f"Línea {source_line}: resultado JSON inválido: {exc.msg}."
                ) from exc

            if not isinstance(expected_row, dict) or not expected_row:
                raise ValueError(
                    f"Línea {source_line}: el resultado debe ser un objeto JSON."
                )

            indexed_rows[case_id].append((row_number, expected_row))

    complete: dict[str, list[dict[str, Any]]] = {}

    for case_id, rows in indexed_rows.items():
        ordered = sorted(rows, key=lambda item: item[0])
        indexes = [row_number for row_number, _ in ordered]
        expected_indexes = list(range(1, len(ordered) + 1))

        if indexes != expected_indexes:
            raise ValueError(
                f"{case_id}: los números de fila deben ser consecutivos "
                f"desde 1; se recibió {indexes}."
            )

        complete[case_id] = [row for _, row in ordered]

    return complete


def _build_case(
    base_case: dict[str, Any],
    *,
    expected_rows: list[dict[str, Any]],
) -> dict[str, Any]:
    case = json.loads(json.dumps(base_case, ensure_ascii=False))
    metadata = case["metadata"]
    omitted_columns = set(metadata.get("omitted_optional_columns", []))

    for row in expected_rows:
        for column in omitted_columns:
            row.pop(column, None)

    previous_expected = case["reference_outputs"]["expected_result"]
    case["reference_outputs"]["expected_result"] = {
        "row_count": len(expected_rows),
        "rows": expected_rows,
        "numeric_tolerance": previous_expected.get("numeric_tolerance", 0.01),
    }
    metadata["dataset_version"] = DATASET_VERSION
    metadata["quality_status"] = "candidate_pending_db_validation"
    metadata["complete_expected_result"] = True
    metadata["response_source_id"] = (
        f"GS-{int(case['case_id'].removeprefix('golden_')):03d}"
    )
    return case


def _load_jsonl(path: Path) -> list[dict[str, Any]]:
    with path.open("r", encoding="utf-8") as jsonl_file:
        return [
            json.loads(line)
            for line in jsonl_file
            if line.strip()
        ]


def _write_jsonl(path: Path, cases: list[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    with path.open("w", encoding="utf-8", newline="\n") as jsonl_file:
        for case in cases:
            jsonl_file.write(
                json.dumps(case, ensure_ascii=False, separators=(",", ":"))
            )
            jsonl_file.write("\n")


def main() -> None:
    args = parse_args()
    cases = build_golden_set_v2(
        args.responses_csv,
        base_path=args.base_path,
        destination=args.destination,
        encoding=args.encoding,
        delimiter=args.delimiter,
    )
    total_rows = sum(
        case["reference_outputs"]["expected_result"]["row_count"]
        for case in cases
    )
    print(
        f"Candidato v2 generado: {len(cases)} casos y {total_rows} "
        f"filas esperadas en {args.destination}."
    )


if __name__ == "__main__":
    main()
